+
+/// Decide `impact` from the classifier's `verdict` and the plan's keywords.
+///
+/// A verdict at or above [`MIN_RENDER_P`] naming a label of the intent table
+/// decides: an edit label (`bugfix`, `feature`, `refactor`) runs `impact`,
+/// any other label does not, unless the prompt explicitly asks about callers
+/// or usages (`who calls X`, `what uses X`): that is a lookup the classifier's
+/// `question` does not cancel. Without such a verdict the keywords decide and
+/// the brief says nothing about intent.
+fn decide_change(plan: &Plan, verdict: Option<&Intent>) -> ChangeCall {
+    let Some(verdict) =
+        verdict.filter(|verdict| verdict.p >= MIN_RENDER_P && ops_for(&verdict.label).is_some())
+    else {
+        return ChangeCall {
+            impact: plan.change_intent,
+            note: None,
+        };
+    };
+    let classified = Some(format!("intent: {} (classify)", verdict.label));
+    if CHANGE_LABELS.contains(&verdict.label.as_str()) {
+        ChangeCall {
+            impact: true,
+            note: classified,
+        }
+    } else if plan.asks_callers {
+        ChangeCall {
+            impact: true,
+            note: Some("intent: caller lookup (keywords)".to_string()),
+        }
+    } else {
+        ChangeCall {
+            impact: false,
+            note: classified,
+        }
+    }
+}
