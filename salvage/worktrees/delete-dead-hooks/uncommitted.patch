+        let text = context(&output);
+        assert!(
+            text.contains("\ncallers (impact d1): apps/web/page.tsx -> Page:2"),
+            "{tag}: {text}"
+        );
+        assert!(!text.contains("intent:"), "{tag}: {text}");
+        assert!(
+            text.contains("\nconfidence: high | ops: 3/4\n"),
+            "{tag}: {text}"
+        );
+        assert_eq!(
+            connections.load(Ordering::SeqCst),
+            0,
+            "{tag}: a disabled or remote classify never touches the local engine"
+        );
+    }
+}
