+        let typed = plan.typed.clone();
+        // A refused spawn drops the sender: the receiver reads "no verdict".
+        let _ = std::thread::Builder::new()
+            .name("pixel-brief-intent".into())
+            .spawn(move || {
+                let _ = sender.send(intent(&typed));
+            });
+    }
+    verdicts
