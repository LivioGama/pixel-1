+/// The classifier's verdicts, delivered by the thread that asked for one.
+pub(crate) type Verdicts = Receiver<Option<Intent>>;
+
+/// The verdict if it arrives before `deadline` less [`IMPACT_RESERVE`];
+/// `None` for a late one, a failed call and a call never made.
+fn await_verdict(verdicts: &Verdicts, deadline: Instant) -> Option<Intent> {
+    let until = deadline.checked_sub(IMPACT_RESERVE).unwrap_or(deadline);
+    verdicts
+        .recv_timeout(until.saturating_duration_since(Instant::now()))
+        .ok()
+        .flatten()
+}
