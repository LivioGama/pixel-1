-/// Single-quote `s` for shell interpolation, leaving it bare when it is
-/// already shell-safe (so common roots like `/repo` stay readable).
-fn shell_quote(s: &str) -> String {
-    if s.is_empty() {
-        return "''".to_string();
-    }
-    if s.chars().all(|c| {
-        c.is_ascii_alphanumeric()
-            || matches!(c, '/' | '.' | '_' | '-' | ':' | '=' | '+' | '@' | '~')
-    }) {
-        return s.to_string();
-    }
-    format!("'{}'", s.replace('\'', "'\\''"))
-}
