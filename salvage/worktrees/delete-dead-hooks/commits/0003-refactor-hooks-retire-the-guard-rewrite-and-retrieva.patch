-        return (1..=200).contains(&limit);
-    }
-    match (
-        input
-            .get("StartLine")
-            .or_else(|| input.get("start_line"))
-            .and_then(Value::as_u64),
-        input
-            .get("EndLine")
-            .or_else(|| input.get("end_line"))
-            .and_then(Value::as_u64),
-    ) {
-        (Some(start), Some(end)) => line_range_is_bounded(start as usize, end as usize),
-        _ => false,
