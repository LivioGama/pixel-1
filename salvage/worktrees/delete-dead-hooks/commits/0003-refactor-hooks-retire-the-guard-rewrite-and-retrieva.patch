-        format!(
-            "{retrieval}\n\n{}",
-            crate::execution_brief::pretty_retrieval_route(route)
-        )
-    } else {
-        retrieval
-    };
-    serde_json::json!({
-        "injectSteps": [{"ephemeralMessage": message}]
-    })
-}
