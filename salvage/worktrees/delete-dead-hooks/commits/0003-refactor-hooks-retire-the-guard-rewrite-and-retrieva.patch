-        }
-        let content = value.get("content").and_then(Value::as_str)?;
-        let content = content
-            .split_once("<USER_REQUEST>")
-            .map_or(content, |(_, remainder)| {
-                remainder
-                    .split_once("</USER_REQUEST>")
-                    .map_or(remainder, |(request, _)| request)
