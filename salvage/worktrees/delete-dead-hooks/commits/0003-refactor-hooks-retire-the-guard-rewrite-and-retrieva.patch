-/// `sed -i`, `-ni`, `-i.bak`, `--in-place`: a write, so never judged a read.
-fn sed_edits_in_place(args: &[String]) -> bool {
-    args.iter().any(|arg| {
-        arg.starts_with("--in-place")
-            || (arg.starts_with('-') && !arg.starts_with("--") && arg.contains('i'))
-    })
-}
