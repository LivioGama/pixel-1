-        std::process::exit(0);
-    };
-    let Ok(payload) = serde_json::from_slice::<Value>(&raw) else {
-        std::process::exit(0);
-    };
-    if !is_guard_event(
-        &payload,
-        payload
-            .get("hook_event_name")
-            .and_then(Value::as_str)
-            .unwrap_or(""),
