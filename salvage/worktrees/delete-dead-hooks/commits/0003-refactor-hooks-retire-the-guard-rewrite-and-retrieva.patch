-        std::process::exit(0);
-    }
-    let Some(tool) = payload.get("tool_name").and_then(Value::as_str) else {
-        std::process::exit(0);
-    };
-    let Some(cwd) = payload
-        .get("cwd")
-        .and_then(Value::as_str)
-        .map(PathBuf::from)
-        .filter(|path| path.is_dir())
