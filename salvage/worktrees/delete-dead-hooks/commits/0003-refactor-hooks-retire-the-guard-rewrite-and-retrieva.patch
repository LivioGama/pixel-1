-        // Worktree: `.git` is a file containing `gitdir: <path>`.
-        let Ok(text) = std::fs::read_to_string(&dot_git) else {
-            return false;
-        };
-        let Some(line) = text.lines().find(|l| l.starts_with("gitdir:")) else {
-            return false;
-        };
