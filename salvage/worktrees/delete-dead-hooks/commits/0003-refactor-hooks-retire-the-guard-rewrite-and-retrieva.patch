-/// Parsed shape of `git commit` arguments, enough to enrich the
-/// `pixel commit` substitute suggestion.
-#[derive(Default)]
-struct CommitArgs {
-    message: Option<String>,
-    all: bool,
-    amend: bool,
-    interactive: bool,
-    files: Vec<String>,
-}
