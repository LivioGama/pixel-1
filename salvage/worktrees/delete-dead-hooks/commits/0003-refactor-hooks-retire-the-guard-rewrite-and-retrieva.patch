-            // value-consuming flag — the common shapes (`git add <files>`,
-            // `git add .`, `git add -A`) are covered.
-            let all_variant = args
-                .iter()
-                .any(|a| a == "." || a == "-A" || a == "--all" || a == "-u" || a == "--update");
