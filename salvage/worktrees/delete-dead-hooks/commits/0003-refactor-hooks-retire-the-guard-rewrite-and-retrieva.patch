-/// True for a combined short-flag cluster containing `c` (e.g. `-fd`
-/// contains 'f', `-Df` contains 'D'). Long flags (`--force`) don't match.
-fn short_cluster_has(token: &str, c: char) -> bool {
-    token.len() >= 2
-        && token.starts_with('-')
-        && !token.starts_with("--")
-        && token[1..].chars().all(|ch| ch.is_ascii_alphanumeric())
-        && token[1..].contains(c)
-}
