-                "--metrics",
-                "--limit",
-                "--offset",
-                "--scope",
-                "--context",
-                "-g",
-                "--glob",
-                "-t",
-                "--type",
-            ],
-            NONE,
-            Some((1, usize::MAX)),
-            usize::MAX,
-        ),
-        "find-code" => spec(
-            &["--json"],
-            &["--metrics", "--limit"],
-            NONE,
-            Some((1, 1)),
-            2,
-        ),
-        "find-symbol" => spec(&["--json"], &["--metrics"], NONE, Some((1, 1)), 2),
-        "pack-context" => spec(
-            &["--json"],
-            &["--metrics", "--budget"],
