-fn git_substitute_deny(sub: &str, args: &[String], root: &Path) -> Option<Vec<String>> {
-    let root_q = shell_quote(&root.display().to_string());
-    match sub {
-        "add" => {
-            // Interactive hunk staging — no pixel equivalent, pass through.
