-                    "  pixel commit --files <f1> [--files <f2> …] --message \"<msg>\" --request-id <id> {root_q}"
-                ));
-                lines.push(
-                    "List each modified tracked file as its own --files flag (run `pixel what-changed .` to see them).".into(),
-                );
-            } else {
