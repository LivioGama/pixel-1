-    // `hook_event_name` (observed live, cursor-agent 2026.10.01); older
-    // builds omit the field entirely, which is the implicit-shape arm below.
-    if event == "PreToolUse"
-        || event == "BeforeTool"
-        || event == "PostToolUse"
-        || event == "preToolUse"
-        || event == "postToolUse"
