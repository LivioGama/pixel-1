-    // some agents use "query". Read/Glob don't have pattern fields.
-    // Antigravity's grep_search uses "Query"; file_search uses "Query".
-    if !matches!(
-        tool,
-        "Grep" | "grep" | "search" | "grep_search" | "file_search"
