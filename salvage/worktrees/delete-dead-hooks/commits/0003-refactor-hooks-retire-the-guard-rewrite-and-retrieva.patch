-/// Commit flags that consume a following value token (so the value must
-/// not be mistaken for a pathspec).
-const COMMIT_VALUE_FLAGS: &[&str] = &[
-    "-m",
-    "--message",
-    "-C",
-    "-c",
-    "--fixup",
-    "--squash",
-    "-F",
-    "--file",
-    "--author",
-    "--date",
-    "-t",
-    "--template",
-    "--trailer",
-];
