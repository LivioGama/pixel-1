-        assert!(
-            msg.contains(substitute_fragment),
-            "substitute for `{cmd}` must contain `{substitute_fragment}`: {msg}"
-        );
-        assert!(
-            !msg.contains("PIXEL_GUARD_RAW_GIT=1"),
-            "human-override env var must NOT be advertised in deny for `{cmd}`: {msg}"
-        );
-        msg
-    }
