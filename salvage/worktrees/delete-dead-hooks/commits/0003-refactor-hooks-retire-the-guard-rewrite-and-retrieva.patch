-/// A low similarity after a completion signal, or a very low one without
-/// it, starts a new task.
-fn is_task_boundary(similarity: f32, completion: bool) -> bool {
-    if completion {
-        similarity < SIMILARITY_THRESHOLD
-    } else {
-        similarity < WEAK_THRESHOLD
