-        return None;
-    }
-    let mut paths = tx
-        .prepare(
-            "SELECT DISTINCT f.path FROM symbols dst
-         JOIN edges e ON e.dst_id = dst.id JOIN symbols src ON src.id = e.src_id
-         JOIN files f ON f.id = src.file_id
-         WHERE dst.file_id = ?1 AND src.file_id != ?1 ORDER BY f.path LIMIT ?2",
