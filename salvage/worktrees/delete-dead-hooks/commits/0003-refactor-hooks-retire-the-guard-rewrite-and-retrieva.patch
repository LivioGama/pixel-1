-        let tool = call.get("name").cloned().unwrap_or(Value::Null);
-        let input = call.get("args").cloned().unwrap_or(Value::Null);
-        let cwd = input
-            .get("Cwd")
-            .or_else(|| payload.get("workspacePaths")?.as_array()?.first())
-            .cloned()
-            .unwrap_or(Value::Null);
