-fn bash_deny_lines(cmd: &str, idx_root: Option<&Path>) -> Option<Vec<String>> {
-    let root = idx_root?;
-    if !cmd.contains("git") {
-        return None;
-    }
-    for GitInvocation { sub, args, .. } in git_invocations(cmd) {
-        if let Some(lines) = destructive_git_deny(&sub, &args, root) {
