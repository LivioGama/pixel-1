+/// Bytes occupied by the explicitly rebuildable index artifacts.
+fn reclaimable_size(pixel_dir: &Path) -> u64 {
+    let mut total = 0;
+    for path in rebuildable_paths(pixel_dir) {
+        if let Ok(metadata) = std::fs::symlink_metadata(path)
+            && metadata.file_type().is_file()
+        {
+            total += metadata.len();
+        }
+    }
+    total
+}
+
+fn rebuildable_paths(pixel_dir: &Path) -> Vec<PathBuf> {
+    REBUILDABLE_FILES
+        .iter()
+        .map(|name| pixel_dir.join(name))
+        .collect()
+}
+
+/// Remove only known derived files; never recursively delete a `.pixel` tree.
+fn remove_rebuildable_files(pixel_dir: &Path) -> Result<(usize, u64), String> {
+    let mut removed = 0;
+    let mut bytes = 0;
+    for path in rebuildable_paths(pixel_dir) {
+        let metadata = match std::fs::symlink_metadata(&path) {
+            Ok(metadata) if metadata.file_type().is_file() => metadata,
+            Ok(_) => continue,
+            Err(error) if error.kind() == std::io::ErrorKind::NotFound => continue,
+            Err(error) => return Err(format!("space: {}: {error}", path.display())),
+        };
+        std::fs::remove_file(&path)
+            .map_err(|error| format!("space: {}: {error}", path.display()))?;
+        removed += 1;
+        bytes += metadata.len();
+    }
+    Ok((removed, bytes))
+}
