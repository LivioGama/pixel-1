+
+    let out = pixel_output(&["space", "--delete", base.to_str().unwrap()]);
+    let stdout = String::from_utf8(out.stdout).unwrap();
+    let stderr = String::from_utf8(out.stderr).unwrap();
+    assert!(!out.status.success(), "{stdout}\n{stderr}");
+    assert!(
+        stderr.contains("space: aborted — nothing deleted"),
+        "{stderr}"
+    );
+    assert_eq!(
+        std::fs::read(proj.join(".pixel/base.shard")).unwrap().len(),
