+# Open the two panes of a case: a new arena tab, or with $4=1 two splits in
+# the current tab next to the caller pane (side by side, nothing hidden in a
+# background tab). Sets TAB_ID ("" in --here mode), P_PANE, N_PANE.
+make_panes() { # $1 label, $2 pixel cwd, $3 no-pixel cwd, $4 here, $5 focus flag
+  if [ "$4" = "1" ]; then
+    TAB_ID=''
+    P_PANE=$(hd pane split --current --direction right --ratio 0.34 --cwd "$2" --no-focus | jq -r '.result.pane.pane_id')
+    N_PANE=$(hd pane split "$P_PANE" --direction right --ratio 0.5 --cwd "$3" --no-focus | jq -r '.result.pane.pane_id')
+    return
+  fi
+  local w tj
+  w=$(focused_workspace)
+  tj=$(hd tab create --workspace "$w" --cwd "$2" --label "$PREFIX:$1" "$5")
+  TAB_ID=$(jq -r '.result.tab.tab_id' <<<"$tj")
+  P_PANE=$(jq -r '.result.root_pane.pane_id' <<<"$tj")
+  N_PANE=$(hd pane split "$P_PANE" --direction right --ratio 0.5 --cwd "$3" --no-focus | jq -r '.result.pane.pane_id')
+}
