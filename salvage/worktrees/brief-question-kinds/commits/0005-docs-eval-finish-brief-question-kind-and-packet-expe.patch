+{
+  "id": "qk-architecture",
+  "suite": "brief-question-kinds",
+  "task_class": "explanation",
+  "mode": "answer",
+  "commit": "8fe6e10cedd2ebecd3bde78ba84c910cd1cd62e1",
+  "max_turns": 30,
+  "prompt": "Describe the code boundary for the prompt brief from host hook receipt to rendered evidence context. Which module owns retrieval and which owns the host envelope?",
+  "must": [
+    {
+      "pattern": "(?i)task_hook",
+      "points": 1,
+      "why": "identifies the host-hook module"
+    },
+    {
+      "pattern": "(?i)execution_brief.{0,80}chain|chain.{0,80}execution_brief",
