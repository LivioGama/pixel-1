-# Mutation coverage is proved in CI. Before pushing Rust changes, make its
-# prospective mutation surface visible and require a receipt for this exact
-# commit, base and listing.
+# Mutation coverage is proved before the push, off this machine: the gate
+# script bundles the committed diff to the gate host (PIXEL_MUTANTS_GATE_HOST,
+# default a2) where the campaign runs against a warm target/, and the push is
+# blocked on the remote verdict. Nothing mutant-related compiles or runs
+# locally; CI's Mutants in diff remains the required merge gate.
 set -eu
 
 repo=$(git rev-parse --show-toplevel) || exit 0
-"$repo/scripts/mutants-preflight.sh" --check
+"$repo/scripts/mutants-remote-gate.sh"
 
 # review-gate: the branch must sit on the freshest remote default and the
 # deterministic review must hold no BLOCKER or CONCERN finding. Skipped when
