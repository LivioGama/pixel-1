+# Inner-loop debug builds keep line tables only: full debuginfo is ~90% of
+# an incremental rebuild of the pixel crate (2.9 s vs 46.7 s, measured
+# 2026-10-03) and grows superlinearly with it. CI's Mutants shards already
+# run this way via CARGO_PROFILE_DEV_DEBUG. Backtraces keep file:line; a
+# debugger needs `cargo build --profile dev-full` below.
+[profile.dev]
+debug = "line-tables-only"
+
+# Full-debuginfo dev build for debugger sessions: `cargo build --profile dev-full`.
+[profile.dev-full]
+inherits = "dev"
+debug = true
+
 [profile.release]
 lto = "thin"
 codegen-units = 1
