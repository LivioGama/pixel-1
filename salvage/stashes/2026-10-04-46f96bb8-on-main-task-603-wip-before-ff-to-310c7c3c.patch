+/// Outcome of deploying the OpenCode plugin. The file is wholly pixel's, so
+/// (unlike the AGENTS.md managed block) there is no "preserve surrounding
+/// text" path: an existing file that is not ours is left untouched and the
+/// step reports the skip rather than clobbering a user's plugin.
+struct PluginDeploy {
+    /// A write happened (non-dry-run, file was missing or was ours but stale).
+    written: bool,
+    /// The file already held exactly the current asset.
+    current: bool,
+    /// Deployment was skipped because the path is user-owned or unreadable.
+    skipped: Option<String>,
+}
+
+impl PluginDeploy {
+    fn would_change(&self) -> bool {
+        // A current file is not a change; a skipped file is not a change.
+        !self.current && self.skipped.is_none()
+    }
+
+    /// "deployed" | "verified" | "skipped: <reason>".
+    fn word(&self) -> String {
+        if self.skipped.is_some() {
+            format!("skipped: {}", self.skipped.as_deref().unwrap_or_default())
+        } else if self.written {
+            "deployed".to_string()
+        } else {
+            "verified".to_string()
+        }
+    }
+}
+
+/// Plan and (when not `dry_run`) perform the plugin deploy. Reads the existing
+/// file to decide whether to write, refuse, or skip:
+/// - missing → write the asset;
+/// - equals the asset → already current, no write;
+/// - carries our marker but differs → ours but stale, overwrite;
+/// - present without the marker → user-owned, skip (do not clobber);
+/// - unreadable for a reason other than NotFound → skip (do not clobber a
+///   file we cannot read).
+///
+/// The plugins directory is created on demand only when a write happens.
+fn deploy_plugin(config_dir: &Path, dry_run: bool) -> Result<PluginDeploy> {
+    let path = plugin_path(config_dir);
+    let existing = match fs::read_to_string(&path) {
+        Ok(content) => Some(content),
+        Err(e) if e.kind() == io::ErrorKind::NotFound => None,
+        Err(e) => {
+            return Ok(PluginDeploy {
+                written: false,
+                current: false,
+                skipped: Some(format!("{} unreadable ({e})", path.display())),
+            });
+        }
+    };
+    if let Some(content) = &existing {
+        if content == OPENCODE_PIXEL_PLUGIN_ASSET {
+            return Ok(PluginDeploy { written: false, current: true, skipped: None });
+        }
+        if !content.contains(OPENCODE_PIXEL_PLUGIN_MARKER) {
+            return Ok(PluginDeploy {
+                written: false,
+                current: false,
+                skipped: Some(format!(
+                    "user-owned {} present; not overwritten",
+                    path.display()
+                )),
+            });
+        }
+        // Ours but stale: fall through to overwrite.
+    }
+    if dry_run {
+        return Ok(PluginDeploy { written: false, current: false, skipped: None });
+    }
+    fs::create_dir_all(plugins_dir(config_dir))?;
+    install::write_atomically(&path, OPENCODE_PIXEL_PLUGIN_ASSET)?;
+    Ok(PluginDeploy { written: true, current: false, skipped: None })
+}
