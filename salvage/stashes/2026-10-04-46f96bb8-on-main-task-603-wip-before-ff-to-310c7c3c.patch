+/// Return an explicitly marked code identifier without guessing from prose.
+///
+/// Backticks and call syntax make exact-name search safer than treating any
+/// capitalized word as a symbol. Unmarked tasks use behavior search instead.
+pub(crate) fn explicit_identifier(task: &str) -> Option<String> {
+    let mut ticks = task.match_indices('`').map(|(index, _)| index);
+    while let Some(start) = ticks.next() {
+        let end = ticks.next()?;
+        let candidate = task[start + 1..end].trim();
+        if identifier_shape(candidate) {
+            return Some(candidate.to_string());
+        }
+    }
+
+    task.split_whitespace().find_map(|part| {
+        let candidate = part
+            .strip_suffix("()")
+            .unwrap_or(part)
+            .trim_matches(|character: char| !character.is_alphanumeric() && character != '_');
+        (part.ends_with("()") && identifier_shape(candidate)).then(|| candidate.to_string())
+    })
+}
+
+fn identifier_shape(candidate: &str) -> bool {
+    let mut characters = candidate.chars();
+    let Some(first) = characters.next() else {
+        return false;
+    };
+    (first == '_' || first.is_alphabetic())
+        && characters.all(|character| character == '_' || character.is_alphanumeric())
+}
