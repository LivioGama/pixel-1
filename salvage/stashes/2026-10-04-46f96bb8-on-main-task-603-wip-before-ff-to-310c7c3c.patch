+/// Turn one Pixel path and line into a portable, shell-quoted 40-line read.
+pub fn bounded_read_command(path: &str, line: u64) -> Option<String> {
+    let parsed_path = Path::new(path);
+    if path.is_empty()
+        || line == 0
+        || path.contains('\n')
+        || path.contains('\r')
+        || parsed_path.is_absolute()
+        || parsed_path
+            .components()
+            .any(|component| matches!(component, Component::ParentDir | Component::Prefix(_)))
+    {
+        return None;
+    }
+    let end = line.saturating_add(MAX_ROUTE_READ_LINES - 1);
+    let path = if path.starts_with('-') {
+        format!("./{path}")
+    } else {
+        path.to_string()
+    };
+    Some(format!("rtk sed -n '{line},{end}p' {}", shell_quote(&path)))
+}
+
+/// Render a compact, ordered route for prompt and hook consumers.
+pub fn pretty_retrieval_route(route: &Value) -> String {
+    let Some(steps) = route.get("steps").and_then(Value::as_array) else {
+        return "Pixel route unavailable; continue with native tools.".to_string();
+    };
+    let mut output = String::from("Deterministic Pixel route (index is a lower bound):");
+    for step in steps {
+        let order = step["order"].as_u64().unwrap_or(0);
+        let action = step["action"].as_str().unwrap_or("step");
+        let command = step["command"].as_str().unwrap_or("");
+        if action == "read_result" {
+            let max_lines = step["max_lines"].as_u64().unwrap_or(MAX_ROUTE_READ_LINES);
+            output.push_str(&format!(
+                "\n{order}. {action} (maximum {max_lines} lines): {command}"
+            ));
+        } else {
+            output.push_str(&format!("\n{order}. {action}: {command}"));
+        }
+    }
+    if let Some(retry) = route.get("retry").and_then(Value::as_object) {
+        output.push_str(&format!(
+            "\nRetry only if {}: {}",
+            retry
+                .get("after")
+                .and_then(Value::as_str)
+                .unwrap_or("needed"),
+            retry.get("command").and_then(Value::as_str).unwrap_or("")
+        ));
+    }
+    if let Some(fallback) = route.get("fallback").and_then(Value::as_object) {
+        output.push_str(&format!(
+            "\nAfter two nonconverging Pixel calls, use: {}",
+            fallback
+                .get("command")
+                .and_then(Value::as_str)
+                .unwrap_or("")
+        ));
+    }
+    if let Some(unavailable) = route.get("on_unavailable").and_then(Value::as_str) {
+        output.push_str(&format!("\nIf Pixel is unavailable: {unavailable}"));
+    }
+    output
+}
