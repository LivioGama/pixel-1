+/// The OpenCode V2 plugin `pixel install` deploys globally. Auto-loaded from
+/// `~/.config/opencode/plugins/` (OpenCode discovers direct `.ts` and `.js`
+/// files there without a `plugins` config entry), so install writes only this
+/// file — no `opencode.json` edit, no double-load. See
+/// <https://opencode.ai/v2/docs/plugins>.
+pub(crate) const OPENCODE_PIXEL_PLUGIN_ASSET: &str = include_str!("../assets/opencode-pixel.js");
+
+/// File name of the deployed plugin, relative to `<config_dir>/plugins/`.
+/// `.js` is one of the two documented auto-discovered direct-file extensions
+/// (`.ts` and `.js`); `.mjs` is not listed by the V2 docs.
+const OPENCODE_PIXEL_PLUGIN_FILE: &str = "opencode-pixel.js";
