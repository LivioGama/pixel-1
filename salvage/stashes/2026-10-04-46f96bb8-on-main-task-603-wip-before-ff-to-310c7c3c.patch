+                || "After an edit, run the smallest test covering the changed behavior; no package target is known yet.".to_string(),
+                |package| format!("After an edit, run the focused package tests: rtk cargo test -p {package}."),
+            )
+        }
+        _ => "If this remains read-only, run no tests; after edits, run the smallest test covering the changed behavior.".to_string(),
+    }
+}
+
+fn package_for_path(path: &str) -> Option<&str> {
+    let mut components = path.split('/');
+    if components.next()? != "crates" {
+        return None;
+    }
+    match components.next()? {
+        "pixel" => Some("pixel-cli"),
+        package => Some(package),
+    }
+}
+
+fn narrower_query(query: &str) -> String {
+    let terms: Vec<&str> = query
+        .split(|character: char| !character.is_alphanumeric() && character != '_')
+        .filter(|term| term.chars().count() > 2)
+        .filter(|term| {
+            !matches!(
+                term.to_ascii_lowercase().as_str(),
+                "the"
+                    | "and"
+                    | "for"
+                    | "with"
+                    | "from"
+                    | "that"
+                    | "this"
+                    | "find"
+                    | "trace"
+                    | "show"
+                    | "explain"
+                    | "where"
+                    | "how"
+                    | "code"
+                    | "path"
+                    | "which"
+                    | "item"
+                    | "remove"
+                    | "decides"
+                    | "decide"
+                    | "should"
+                    | "would"
+                    | "what"
+            )
+        })
+        .collect();
+    let start = terms.len().saturating_sub(4);
+    terms[start..].join(" ")
+}
+
+fn fallback_term(query: &str) -> String {
+    let preferred = narrower_query(query)
+        .split_whitespace()
+        .max_by_key(|term| term.chars().count())
+        .unwrap_or("");
+    if !preferred.is_empty() {
+        return preferred.to_string();
+    }
+    query
+        .split_whitespace()
+        .last()
+        .map(|term| {
+            term.trim_matches(|character: char| !character.is_alphanumeric() && character != '_')
+                .to_string()
+        })
+        .unwrap_or_default()
+}
+
+fn shell_quote(value: &str) -> String {
+    format!("'{}'", value.replace('\'', "'\\''"))
+}
