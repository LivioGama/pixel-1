+        .output()
+        .unwrap();
+    let routed = fixture
+        .command()
+        .args([
+            "search-like-rg",
+            "grep",
+            "--",
+            "-n",
+            "login_user",
+            "src/login.rs",
+        ])
+        .env("HOME", &home)
+        .env_remove("GREP_OPTIONS")
+        .output()
+        .unwrap();
+    assert_success(&routed);
+    assert_eq!(routed.stdout, native.stdout);
+    assert_eq!(routed.stderr, native.stderr);
+    assert!(metric_lines(&routed).is_empty());
+
+    // The journaled record is what the PostToolUse relay renders.
+    let events = fixture.events("search-like-rg");
+    assert_eq!(events.len(), 1);
+    let metrics = &events[0]["metrics"];
+    assert!(!metrics.is_null(), "protected streams keep accounting");
+    assert!(metrics["duration_us"].as_u64().unwrap() > 0);
+
+    let payload = json!({
+        "tool_name": "exec",
+        "tool_input": {"command": "pixel search-like-rg grep -- '-n' 'login_user' 'src/login.rs'"},
+        "cwd": fixture.0.display().to_string(),
+    });
+    let mut child = fixture
+        .command()
+        .args(["run-hook", "metrics", "--provider", "devin"])
+        .env("HOME", &home)
+        .stdin(Stdio::piped())
+        .stdout(Stdio::piped())
+        .stderr(Stdio::null())
+        .spawn()
+        .unwrap();
+    child
+        .stdin
+        .as_mut()
+        .unwrap()
+        .write_all(payload.to_string().as_bytes())
+        .unwrap();
+    let output = child.wait_with_output().unwrap();
+    assert_success(&output);
+    let doc: Value = serde_json::from_slice(&output.stdout).unwrap();
+    let context = doc["hookSpecificOutput"]["additionalContext"]
+        .as_str()
+        .expect("the relay emits the recorded metrics line as context");
+    assert!(context.contains("🟩 pixel search-like-rg"), "{context}");
+}
+
+/// Every supported opt-out must suppress the hook relay for a protected
+/// retrieval invocation, even though protected streams keep their output
+/// byte-compatible and the action record retains accounting.
+#[test]
+fn protected_search_like_rg_metrics_opt_outs_suppress_the_hook_relay() {
+    use std::io::Write;
+
+    for opt_out in ["flag", "environment", "repo-config"] {
+        let fixture = Fixture::new();
+        let home = fake_home(&fixture);
+        assert_success(&fixture.run(&["build-index", "."]));
+        if opt_out == "repo-config" {
+            assert_success(&fixture.run(&["config", "metrics", "off"]));
+        }
+
+        let mut command = fixture.command();
+        let mut invocation = String::from("pixel ");
+        if opt_out == "flag" {
+            command.arg("--metrics=off");
+            invocation.push_str("--metrics=off ");
+        }
+        command
+            .args([
+                "search-like-rg",
+                "grep",
+                "--",
+                "-n",
+                "login_user",
+                "src/login.rs",
+            ])
+            .env("HOME", &home)
+            .env_remove("GREP_OPTIONS");
+        if opt_out == "environment" {
+            command.env("PIXEL_METRICS", "0");
+        }
+        let routed = command.output().unwrap();
+        assert_success(&routed);
+        assert!(metric_lines(&routed).is_empty(), "{opt_out}: {routed:?}");
+        assert!(
+            String::from_utf8_lossy(&routed.stdout).contains("pub fn login_user"),
+            "the protected retrieval still returns its result for {opt_out}"
+        );
+        let event = fixture.events("search-like-rg").pop().unwrap();
+        assert!(
+            !event["metrics"].is_null(),
+            "the protected action keeps accounting for {opt_out}"
+        );
+
+        invocation.push_str("search-like-rg grep -- '-n' 'login_user' 'src/login.rs'");
+        let payload = json!({
+            "tool_name": "exec",
+            "tool_input": {"command": invocation},
+            "cwd": fixture.0.display().to_string(),
+        });
+        let mut hook_command = fixture.command();
+        hook_command
+            .args(["run-hook", "metrics", "--provider", "devin"])
+            .env("HOME", &home)
+            .stdin(Stdio::piped())
+            .stdout(Stdio::piped())
+            .stderr(Stdio::null());
+        if opt_out == "environment" {
+            hook_command.env("PIXEL_METRICS", "0");
+        }
+        let mut hook = hook_command.spawn().unwrap();
+        hook.stdin
+            .as_mut()
+            .unwrap()
+            .write_all(payload.to_string().as_bytes())
+            .unwrap();
+        let output = hook.wait_with_output().unwrap();
+        assert_success(&output);
+        assert!(
+            output.stdout.is_empty(),
+            "the relay respects {opt_out}: {}",
+            String::from_utf8_lossy(&output.stdout)
         );
     }
 }
