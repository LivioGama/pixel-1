+/// True when a `plugin`/`plugins` entry names `opencode-pixel.js` and
+/// resolves to the path install deploys to. The deployed plugin is
+/// auto-discovered, so an explicit `plugins` entry pointing at it would
+/// double-load it; sweep those entries out. An `opencode-pixel.js` entry
+/// pointing elsewhere is the user's own and is left alone.
+fn is_duplicate_pixel_plugin(entry: &str, config_dir: &Path) -> bool {
+    let entry = entry.trim();
+    if entry.rsplit('/').next() != Some(OPENCODE_PIXEL_PLUGIN_FILE) {
+        return false;
+    }
+    // Ours lives under the config directory, never under `~`.
+    if entry.starts_with('~') {
+        return false;
+    }
+    let p = Path::new(entry);
+    let resolved = if p.is_absolute() {
+        p.to_path_buf()
+    } else {
+        config_dir.join(p)
+    };
+    normalize(&resolved) == normalize(&plugin_path(config_dir))
+}
+
+/// Lexical path normalization (drop `.` and resolve `..`) so `./plugins/x`
+/// compares equal to `<config_dir>/plugins/x`. `..` past the root is clamped.
+fn normalize(path: &Path) -> PathBuf {
+    let mut out = PathBuf::new();
+    for component in path.components() {
+        match component {
+            std::path::Component::CurDir => {}
+            std::path::Component::ParentDir => {
+                out.pop();
+            }
+            other => out.push(other.as_os_str()),
+        }
+    }
+    out
+}
